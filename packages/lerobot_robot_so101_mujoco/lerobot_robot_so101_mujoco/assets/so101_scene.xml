<!-- LeRobot SO-101 MuJoCo scene.
     Source of truth: TheRobotStudio/SO-ARM100 Simulation/SO101 (so101_new_calib).
     IITD_EPR_KIT4-main ships the same CAD via ROS2 URDF/Gazebo only (no MJCF);
     this scene is the official MuJoCo port of that SO-101 geometry. -->
<mujoco model="so101_lerobot_scene">
  <include file="so101_new_calib.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>
    <!-- Overview camera for LeRobot sim observations (USB-cam analogue) -->
    <camera name="front" pos="0.55 -0.35 0.45" xyaxes="0.7 0.7 0 -0.35 0.35 0.87" fovy="45"/>
    <!-- Visual-only sorting workspace markers -->
    <geom name="workspace" type="box" pos="0.22 0 0.001" size="0.15 0.15 0.001"
          rgba="0.85 0.85 0.8 1" contype="0" conaffinity="0"/>
    <geom name="bin_red" type="box" pos="0.28 -0.10 0.02" size="0.04 0.04 0.02"
          rgba="0.85 0.2 0.2 1" contype="0" conaffinity="0"/>
    <geom name="bin_blue" type="box" pos="0.28 0.0 0.02" size="0.04 0.04 0.02"
          rgba="0.2 0.35 0.85 1" contype="0" conaffinity="0"/>
    <geom name="bin_green" type="box" pos="0.28 0.10 0.02" size="0.04 0.04 0.02"
          rgba="0.2 0.7 0.3 1" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
