+class _StdinKeyboardListener:
+    """Read episode-control keys from the TTY without macOS Accessibility."""
+
+    def __init__(self, on_key):
+        self._on_key = on_key
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._fd: int | None = None
+        self._old_term = None
+
+    def start(self) -> None:
+        if not sys.stdin.isatty():
+            logging.warning(
+                "stdin is not a TTY — terminal key fallback disabled. "
+                "Run recording from an interactive terminal, or grant Accessibility for pynput."
+            )
+            return
+        try:
+            import termios
+            import tty
+        except ImportError:
+            return
+
+        self._fd = sys.stdin.fileno()
+        self._old_term = termios.tcgetattr(self._fd)
+        tty.setcbreak(self._fd)
+        self._thread = threading.Thread(target=self._run, name="stdin-keys", daemon=True)
+        self._thread.start()
+
+    def _run(self) -> None:
+        import select
+
+        buf = ""
+        while not self._stop.is_set():
+            try:
+                ready, _, _ = select.select([sys.stdin], [], [], 0.05)
+            except (ValueError, OSError):
+                break
+            if not ready:
+                # Flush a lone Esc after a short idle gap
+                if buf == "\x1b":
+                    self._on_key("stop")
+                    buf = ""
+                continue
+            try:
+                chunk = sys.stdin.read(1)
+            except OSError:
+                break
+            if not chunk:
+                continue
+            buf += chunk
+            kind, buf = self._consume(buf)
+            if kind:
+                self._on_key(kind)
+
+    @staticmethod
+    def _consume(buf: str) -> tuple[str | None, str]:
+        # CSI arrow sequences
+        if buf.startswith("\x1b["):
+            if len(buf) < 3:
+                return None, buf
+            code = buf[2]
+            rest = buf[3:]
+            if code == "C":
+                return "next", rest
+            if code == "D":
+                return "rerecord", rest
+            return None, rest  # ignore other CSI
+        if buf.startswith("\x1bO"):  # application-mode arrows
+            if len(buf) < 3:
+                return None, buf
+            code = buf[2]
+            rest = buf[3:]
+            if code == "C":
+                return "next", rest
+            if code == "D":
+                return "rerecord", rest
+            return None, rest
+        ch = buf[0]
+        rest = buf[1:]
+        if ch in ("\n", "\r", "n", "N"):
+            return "next", rest
+        if ch in ("r", "R"):
+            return "rerecord", rest
+        if ch in ("q", "Q"):
+            return "stop", rest
+        if ch == "\x1b":
+            return None, buf  # wait for more / timeout in _run
+        return None, rest
+
+    def stop(self) -> None:
+        self._stop.set()
+        if self._thread is not None:
+            self._thread.join(timeout=1.0)
+            self._thread = None
+        if self._fd is not None and self._old_term is not None:
+            try:
+                import termios
+
+                termios.tcsetattr(self._fd, termios.TCSADRAIN, self._old_term)
+            except Exception:
+                pass
+            self._fd = None
+            self._old_term = None
+
+
+class _CompositeKeyboardListener:
+    def __init__(self, pynput_listener, stdin_listener: _StdinKeyboardListener):
+        self._pynput = pynput_listener
+        self._stdin = stdin_listener
+
+    def stop(self) -> None:
+        try:
+            self._pynput.stop()
+        except Exception:
+            pass
+        self._stdin.stop()
 
 
