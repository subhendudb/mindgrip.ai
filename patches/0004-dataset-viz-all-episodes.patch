+def _load_frame_table(root: Path) -> pa.Table:
+    files = sorted((root / "data").rglob("*.parquet"))
+    if not files:
+        raise FileNotFoundError(f"No parquet files under {root / 'data'}")
+    return pa.concat_tables([pq.read_table(path) for path in files])
+
+
+def visualize_all_episodes(
+    repo_id: str,
+    root: Path,
+    mode: str = "local",
+    web_port: int = 9090,
+    grpc_port: int = 9876,
+    save: bool = False,
+    output_dir: Path | None = None,
+    **kwargs,
+) -> Path | None:
+    """Log every episode as its own Rerun recording (state/action plots + Episodes timeline)."""
+    from lerobot.utils.import_utils import require_package
+
+    require_package("rerun-sdk", extra="viz", import_name="rerun")
+    import rerun as rr
+    import rerun.blueprint as rrb
+
+    if mode not in ["local", "distant"]:
+        raise ValueError(mode)
+
+    root = Path(root)
+    info_path = root / "meta" / "info.json"
+    if not info_path.is_file():
+        raise FileNotFoundError(f"Dataset info.json not found at {info_path}")
+
+    info = json.loads(info_path.read_text())
+    fps = float(info.get("fps") or 30)
+
+    logging.info("Loading frame table from %s", root)
+    table = _load_frame_table(root)
+    episode_ids = np.asarray(table.column("episode_index").to_pylist(), dtype=np.int64)
+    frame_index = np.asarray(table.column("frame_index").to_pylist(), dtype=np.int64)
+    global_index = np.asarray(table.column("index").to_pylist(), dtype=np.int64)
+    action = np.stack(table.column(ACTION).to_pylist()).astype(np.float64)
+    state = np.stack(table.column(OBS_STATE).to_pylist()).astype(np.float64)
+    times = global_index.astype(np.float64) / fps
+    unique_episodes = [int(ep) for ep in np.unique(episode_ids)]
+    n_joints = int(state.shape[1])
+
+    blueprint = rrb.Blueprint(
+        rrb.Horizontal(
+            rrb.TimeSeriesView(origin="state", name="state"),
+            rrb.TimeSeriesView(origin="action", name="action"),
+            column_shares=[1, 1],
+        ),
+        rrb.TimePanel(expanded=True),
+    )
+
+    logging.info("Starting Rerun with %s episodes", len(unique_episodes))
+    streams: list = []
+    first = True
+
+    for ep in tqdm.tqdm(unique_episodes, desc="Logging episodes"):
+        rec = rr.RecordingStream(repo_id, recording_id=str(ep))
+        streams.append(rec)
+        if first:
+            if mode == "local" and not save:
+                rec.spawn(memory_limit="50%", hide_welcome_screen=True, default_blueprint=blueprint)
+            elif mode == "distant":
+                rec.serve_grpc(grpc_port=grpc_port)
+            first = False
+        else:
+            rec.connect_grpc()
+
+        mask = episode_ids == ep
+        ep_times = times[mask]
+        ep_frames = frame_index[mask]
+        ep_state = state[mask]
+        ep_action = action[mask]
+        indexes = [
+            rr.TimeColumn("timestamp", duration=ep_times),
+            rr.TimeColumn("frame_index", sequence=ep_frames),
+        ]
+        for dim in range(n_joints):
+            rec.send_columns(
+                f"state/j{dim + 1}",
+                indexes=indexes,
+                columns=rr.Scalars.columns(scalars=ep_state[:, dim]),
+            )
+            rec.send_columns(
+                f"{ACTION}/j{dim + 1}",
+                indexes=indexes,
+                columns=rr.Scalars.columns(scalars=ep_action[:, dim]),
+            )
+
+    gc.collect()
+
+    if mode == "local" and save:
+        output_dir = Path(output_dir)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        repo_id_str = repo_id.replace("/", "_")
+        rrd_path = output_dir / f"{repo_id_str}_all_episodes.rrd"
+        streams[0].save(str(rrd_path))
+        return rrd_path
+
+    if mode == "distant":
+        logging.info(f"Connect to a Rerun Server: rerun rerun+http://IP:{grpc_port}/proxy")
+        rr.serve_web_viewer(open_browser=False, web_port=web_port)
+        try:
+            while True:
+                time.sleep(1)
+        except KeyboardInterrupt:
+            print("Ctrl-C received. Exiting.")
+        return None
+
+    # Keep streams alive until the detached viewer has received everything.
+    for rec in streams:
+        flush = getattr(rec, "flush", None)
+        if callable(flush):
+            flush()
+    return None
+
+
